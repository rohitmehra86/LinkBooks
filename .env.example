# Copy to .env — fill KEYS from your Supabase project API settings.
# Never commit real .env values.
# Development / preview only until a dedicated production project is approved.

# --- Browser (Vite) — publishable only ---
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Server (TanStack Start / Vercel) — mirror URL + publishable ---
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- Server only — NEVER prefix with VITE_ ---
# SUPABASE_SERVICE_ROLE_KEY=

# Optional cron (server only)
# LOVABLE_CRON_SECRET=

# --- AI Accounting Assistant (server only — NEVER VITE_*) ---
# OpenAI-compatible Chat Completions API. Leave unset for honest "not configured" UI.
# AI_API_KEY=
# OPENAI_API_KEY=   # accepted as alias for AI_API_KEY
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_MAX_REQUESTS_PER_HOUR=30
# AI_MAX_CONTEXT_CHARS=12000
# AI_MAX_OUTPUT_TOKENS=1200
